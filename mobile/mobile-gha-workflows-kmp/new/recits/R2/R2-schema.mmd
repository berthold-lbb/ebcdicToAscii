flowchart LR
  HTTP["<b>POST isDeviceCompatible</b><br/>partnerKey · deviceModel · deviceName<br/><i>route introuvable dans le dépôt</i>"]
  CACHE["<b>Cache local</b><br/>clé IS_DEVICE_COMPATIBLE_KEY<br/><i>écrite en Int par le Core</i>"]
  HW["<b>Capteurs de l'appareil</b><br/>GPS · cellulaire<br/>gyroscope · accéléromètre"]

  TS["<b>TypedStorage</b><br/>getInt / putInt<br/><i>créé ici, étendu par R3</i>"]
  DS["<b>KtorDeviceCompatibility<br/>DataSource</b><br/>réseau d'abord,<br/>cache en repli"]

  SIG["<b>signal ④</b><br/>isDeviceCompatible<br/>= liste blanche ET capteurs"]
  R2["<b>règle 2</b><br/>appareil non compatible<br/>priority 2"]
  FAM["<b>famille appareil</b><br/>s'insère entre les règles 1 et 3<br/>↓<br/><b>groupe NOTICE</b> · « Avis »"]

  HTTP --> DS
  CACHE --> TS --> DS
  HW --> SIG
  DS --> SIG --> R2 --> FAM

