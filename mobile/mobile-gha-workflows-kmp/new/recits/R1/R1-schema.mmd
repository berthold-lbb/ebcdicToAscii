  OS1["<b>ACTION_BATTERY_CHANGED</b><br/>diffusion système<br/><i>reçue en avant-plan seulement</i>"]
  OS2["<b>PowerManager</b><br/>isPowerSaveMode<br/><i>lu en direct, aucun signal</i>"]
  OS3["<b>Build.MANUFACTURER</b><br/><i>constante, hors ligne</i>"]
  SDK["<b>CmtService.isInDrive()</b><br/>SDK télématique<br/><i>avant-plan + authentifié</i>"]

  AD["<b>AndroidDeviceStateDataSource</b><br/>androidMain<br/>expose ⑦ ⑧ ⑨ ⑩"]
  AC["<b>AndroidCmtTripSignals<br/>DataSource</b><br/>androidMain<br/>expose ② seulement"]

  S["<b>AjustoContextualSignals</b><br/>⑦ batterie faible · ⑧ charge soutenue<br/>⑨ économie d'énergie · ⑩ marque<br/>② enregistrement en cours"]

  R1["<b>règle 1</b><br/>marque non compatible<br/>priority 1"]
  R3["<b>règle 3</b><br/>batterie faible<br/>priority 3"]
  R4["<b>règle 4</b><br/>économie d'énergie<br/>priority 4"]

  FAM["<b>famille appareil</b><br/>cascade 1 → 3 → 4<br/>au plus UN message<br/>↓<br/><b>groupe NOTICE</b> · « Avis »"]

