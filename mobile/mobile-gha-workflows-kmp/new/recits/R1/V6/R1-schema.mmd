flowchart LR

  OS1["<b>Diffusion système<br/>ACTION_BATTERY_CHANGED</b><br/>émise par Android à chaque<br/>changement d'état de la batterie<br/>reçue par un BroadcastReceiver<br/><i>enregistré en avant-plan seulement</i><br/>──────────────<br/>donne le niveau de charge<br/>et l'état « en charge »"]

  OS2["<b>Service système<br/>PowerManager</b><br/>fourni par Android,<br/>obtenu via getSystemService<br/><i>lu à la demande — Android ne<br/>prévient pas quand ça change</i><br/>──────────────<br/>donne l'état du mode<br/>économie d'énergie"]

  OS3["<b>Constante Build.MANUFACTURER</b><br/>inscrite dans le système par<br/>le fabricant du téléphone<br/><i>ne change jamais, lue hors ligne</i><br/>──────────────<br/>donne le nom du fabricant"]

  SDK["<b>CmtService.isInDrive()</b><br/>interrogé sur le SDK télématique<br/><i>actif en avant-plan et<br/>seulement si authentifié</i><br/>──────────────<br/>dit si un trajet est<br/>en cours d'enregistrement"]

  AD["<b>AndroidDeviceStateDataSource</b><br/>androidMain<br/>──────────────<br/>batterie faible<br/>charge soutenue<br/>mode économie d'énergie actif<br/>marque compatible"]

  AC["<b>AndroidCmtTripSignalsDataSource</b><br/>androidMain<br/>──────────────<br/>trajet en cours d'enregistrement"]

  S["<b>AjustoContextualSignals</b><br/>──────────────<br/>batterie faible<br/>charge soutenue<br/>mode économie d'énergie actif<br/>marque compatible<br/>trajet en cours d'enregistrement"]

  FAM["<b>famille appareil</b> — une seule s'affiche<br/>──────────────────────────────<br/><b>Marque non compatible</b><br/>si le fabricant est sur liste d'exclusion<br/><br/><b>Batterie faible</b><br/>si batterie faible et pas en charge<br/><br/><b>Mode économie d'énergie</b><br/>si le mode est actif et<br/>aucun trajet en cours<br/>──────────────────────────────<br/>↓<br/><b>groupe NOTICE</b> · libellé « Avis »"]

  OS1 --> AD
  OS2 --> AD
  OS3 --> AD
  SDK --> AC
  AD --> S
  AC --> S
  S --> FAM

  classDef base fill:#f5f5f4,stroke:#a8a29e,color:#1c1917
  classDef accent fill:#e6edf5,stroke:#2c5282,color:#1a365d,stroke-width:2px

  class OS1,OS2,OS3,SDK,AD,AC,S base
  class FAM accent
